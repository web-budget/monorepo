# Copie para .env e ajuste o que precisar. Os padrões abaixo funcionam de saída, menos o e-mail.

# --- Versão das imagens ---
# Tag das imagens ghcr.io/web-budget/server e ghcr.io/web-budget/client. A tag latest só existe a partir do v4.0.0,
# porque os RCs são publicados como prerelease e não a movem. Até lá, informe a tag do RC.
WEBBUDGET_VERSION=v4.0.0-rc1

# --- Postgres ---
POSTGRES_DB=webbudget
POSTGRES_USER=sa_webbudget
POSTGRES_PASSWORD=sa_webbudget

# --- Porta da aplicação no host (nginx) ---
WEB_PORT=8080

# --- Fuso do server ---
# Decide o "hoje" do financeiro (vencimentos, períodos, avisos).
TZ=America/Sao_Paulo

# --- Endereço público ---
# Usado nos links dos e-mails e no retorno do login com Google. Atrás de um proxy HTTPS, informe o endereço do proxy.
APPLICATION_FRONTEND_URL=http://localhost:8080

# --- Autenticação ---
# Sem ADMIN_DEFAULT_PASSWORD o server gera uma senha aleatória para admin@webbudget.com.br e a escreve só no log
# (docker compose logs server).
ADMIN_DEFAULT_PASSWORD=
TOTP_REQUIRED=true
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail (SMTP) ---
# Modelo de um SMTP real: troque pelos dados do seu provedor. Sem um SMTP válido, os e-mails de conta e de aviso de
# vencimento falham (o server continua funcionando, só não envia).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=usuario@example.com
MAIL_PASSWORD=senha-do-smtp
MAIL_DEFAULT_FROM_ADDRESS=noreply@example.com
MAIL_REPLY_TO_ADDRESS=noreply@example.com
MAIL_TIME_ZONE=America/Sao_Paulo
